# TICKETMASTER_PROXY_URL: Cloudflare Worker base URL (preferred). See tools/proxy/ticketmaster/README.md.
# Example: https://deadset-ticketmaster-proxy.<account>.workers.dev
TICKETMASTER_PROXY_URL=YOUR_TICKETMASTER_PROXY_URL

# TICKETMASTER_API_KEY: Debug-only direct Discovery key. Ignored in release when a proxy URL is unset
# (release must use the Worker so the key never ships in the APK).
TICKETMASTER_API_KEY=YOUR_TICKETMASTER_API_KEY

# BANDSINTOWN_APP_ID: Registered Bandsintown app ID. Leave as YOUR_BANDSINTOWN_APP_ID to skip requests.
BANDSINTOWN_APP_ID=YOUR_BANDSINTOWN_APP_ID
