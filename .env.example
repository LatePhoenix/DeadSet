# SPOTIFY_CLIENT_ID: Required for Spotify Web API track search and playback integration.
# Configure this in the Secrets panel in the AI Studio UI.
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID

# SPOTIFY_CLIENT_SECRET: Required for Spotify OAuth2 Client Credentials token exchange.
# Configure this in the Secrets panel in the AI Studio UI.
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET

# TICKETMASTER_API_KEY: Optional API key for Ticketmaster Discovery API v2 live concert search.
# Configure this in the Secrets panel in the AI Studio UI.
TICKETMASTER_API_KEY=YOUR_TICKETMASTER_API_KEY

# BANDSINTOWN_APP_ID: App ID used when querying the Bandsintown public artist events API.
# Configure this in the Secrets panel in the AI Studio UI.
BANDSINTOWN_APP_ID=deadset_companion_app
